{
  "expo": {
    "name": "Tempo",
    "slug": "tempo-task-timer",
    "version": "1.1.0",
    "scheme": "tempo",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.personal.tempotimer",
      "versionCode": 2
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Tempo — make time for what matters"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
